# Supply strong unique credentials and a real domain before deployment.
POSTGRES_USER=comtech
POSTGRES_PASSWORD=
POSTGRES_DB=comtech
# URL-encode special characters in database credentials.
DATABASE_URL=
APP_ENV=production
PUBLIC_DOMAIN=
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=comtech-demo
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_TRACING_SAMPLING_RATE=1.0
LANGSMITH_WORKSPACE_ID=
PINECONE_MODE=hosted
PINECONE_API_KEY=
PINECONE_INDEX_NAME=northstar-knowledge-te3s-1536-v1
# Optional: ingestion will resolve the host from the index name when omitted.
PINECONE_INDEX_HOST=
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
INGESTION_SOURCE_ROOT=synthetic_bank/corpus
INGESTION_ARTIFACT_ROOT=var/ingestion
GIT_REVISION=
PINECONE_NAMESPACE_BUDGET=100

# The remote target has not passed the restricted runner deployment acceptance.
BACKGROUND_ENABLED=false
RESEARCH_ENABLED=false
