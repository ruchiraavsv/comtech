# Copy to .env. Development-only database credentials; never reuse remotely.
POSTGRES_USER=comtech
POSTGRES_PASSWORD=comtech-local
POSTGRES_DB=comtech
DATABASE_URL=postgresql://comtech:comtech-local@postgres:5432/comtech
APP_ENV=development
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=comtech-dev
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_TRACING_SAMPLING_RATE=1.0
LANGSMITH_WORKSPACE_ID=
PINECONE_MODE=hosted
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
PINECONE_INDEX_HOST=
OPENAI_API_KEY=
OPENAI_MODEL=
GIT_REVISION=local
# Optional explicit mode: off, phoenix, langsmith. If omitted, use LANGSMITH_TRACING.
# OBSERVABILITY_MODE=off
PHOENIX_PROJECT_NAME=comtech-local
PHOENIX_TRACE_ENDPOINT=http://localhost:6006/v1/traces
TRACE_HIDE_INPUTS=false
TRACE_HIDE_OUTPUTS=false
LOG_FILE_ENABLED=false
LOG_DIRECTORY=var/logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
