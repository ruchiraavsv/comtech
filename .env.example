# Copy to .env. Development-only database credentials; never reuse remotely.
POSTGRES_USER=comtech
POSTGRES_PASSWORD=comtech-local
POSTGRES_DB=comtech
DATABASE_URL=postgresql://comtech:comtech-local@postgres:5432/comtech
APP_ENV=development
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=comtech-dev
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_TRACING_SAMPLING_RATE=1.0
LANGSMITH_WORKSPACE_ID=
PINECONE_MODE=hosted
PINECONE_API_KEY=
PINECONE_INDEX_NAME=northstar-knowledge-te3s-1536-v1
# Optional: ingestion will resolve the host from the index name when omitted.
PINECONE_INDEX_HOST=
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
INGESTION_SOURCE_ROOT=synthetic_bank/corpus
INGESTION_ARTIFACT_ROOT=var/ingestion
GIT_REVISION=local
# Optional explicit mode: off, phoenix, langsmith. If omitted, use LANGSMITH_TRACING.
# OBSERVABILITY_MODE=off
PHOENIX_PROJECT_NAME=comtech-local
PHOENIX_TRACE_ENDPOINT=http://localhost:6006/v1/traces
TRACE_HIDE_INPUTS=false
TRACE_HIDE_OUTPUTS=false
LOG_FILE_ENABLED=false
LOG_DIRECTORY=var/logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
PINECONE_NAMESPACE_BUDGET=100

# Enterprise agents: use compose.agents.yaml to enable and mount source artifacts.
AGENT_MODE=mock
AGENT_BUILD_ID=2fddb22824bee702
AGENT_MCP_URL=http://northstar-mcp:8001/mcp
# Blank role overrides use OPENAI_MODEL if set, otherwise these built-in defaults:
# Supervisor/reviewer/complex worker: gpt-6-sol; simple worker/final wording: gpt-6-luna.
SUPERVISOR_MODEL=
KNOWLEDGE_WORKER_MODEL=
KNOWLEDGE_WORKER_COMPLEX_MODEL=
REVIEWER_MODEL=
FINAL_ANSWER_MODEL=
AGENT_TOKEN_ENCODING=o200k_base
AGENT_MODEL_CONTEXT_WINDOW=128000
AGENT_MODEL_TIMEOUT_SECONDS=45
MAX_SECTIONS_PER_READ=3
MAX_TOKENS_PER_SECTION=1000
MAX_TOKENS_PER_READ=3000
KNOWLEDGE_WORKER_MAX_CYCLES=5
TOTAL_CONTEXT_BUDGET=30000
FINALIZATION_RESERVE=4000
MAX_REVIEW_CYCLES=2
AGENT_MAX_TASKS=6
AGENT_PARALLEL_WORKERS=1
AGENT_TOOL_TIMEOUT_SECONDS=15
AGENT_WORKER_TIMEOUT_SECONDS=90

# Opt-in background lifecycle; leave disabled until the research phase checks pass.
BACKGROUND_ENABLED=false
OBJECTIVE_TIMEOUT_SECONDS=1800
OBJECTIVE_FINALIZATION_SECONDS=180
EVENT_FOLLOW_SECONDS=60

# Optional local Research stack: compose.research.yaml. Defaults remain off.
RESEARCH_ENABLED=false
RESEARCH_SERVICE_TOKEN=
RESEARCH_BROKER_URL=http://research-broker:8002
RESEARCH_API_URL=http://api:8000
RESEARCH_RUNNER_SOCKET=/run/research-control/runner.sock
RESEARCH_ARTIFACT_ROOT=/var/research/artifacts
RESEARCH_MAINTENANCE_SECONDS=300
